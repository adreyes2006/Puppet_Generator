{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/puppet-pipeline/manifest-v1.schema.json",
  "title": "2D Stick-Figure Puppet Manifest",
  "description": "Contract between character generation, skeletal rigging, and downstream animation-controller stages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "naming_version",
    "seed",
    "parameters",
    "objects",
    "bones",
    "control_bones",
    "constraints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "naming_version": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upper_arm_len",
        "forearm_len",
        "thigh_len",
        "shin_len",
        "limb_radius",
        "torso_len",
        "head_radius",
        "hip_width",
        "shoulder_width"
      ],
      "properties": {
        "upper_arm_len": { "$ref": "#/$defs/positiveNumber" },
        "forearm_len": { "$ref": "#/$defs/positiveNumber" },
        "thigh_len": { "$ref": "#/$defs/positiveNumber" },
        "shin_len": { "$ref": "#/$defs/positiveNumber" },
        "limb_radius": { "$ref": "#/$defs/positiveNumber" },
        "torso_len": { "$ref": "#/$defs/positiveNumber" },
        "head_radius": { "$ref": "#/$defs/positiveNumber" },
        "hip_width": { "$ref": "#/$defs/positiveNumber" },
        "shoulder_width": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object" }
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bone" }
    },
    "control_bones": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boneName" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    }
  },
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sideSuffix": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_]*|[A-Za-z][A-Za-z0-9_]*\\.(?:L|R))$"
    },
    "boneName": {
      "allOf": [{ "$ref": "#/$defs/sideSuffix" }]
    },
    "objectName": {
      "type": "string",
      "pattern": "^pup\\.[A-Za-z][A-Za-z0-9_]*(?:\\.(?:L|R))?$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bone", "vertex_count"],
      "properties": {
        "name": { "$ref": "#/$defs/objectName" },
        "bone": { "$ref": "#/$defs/boneName" },
        "vertex_count": { "type": "integer", "minimum": 1 }
      }
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent", "deforms", "ik_chain"],
      "properties": {
        "name": { "$ref": "#/$defs/boneName" },
        "parent": {
          "oneOf": [
            { "$ref": "#/$defs/boneName" },
            { "type": "null" }
          ]
        },
        "deforms": { "type": "boolean" },
        "ik_chain": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bone", "type"],
      "properties": {
        "bone": { "$ref": "#/$defs/boneName" },
        "type": { "enum": ["IK", "LIMIT_ROTATION"] },
        "target": { "$ref": "#/$defs/boneName" },
        "pole": { "$ref": "#/$defs/boneName" },
        "chain_count": { "type": "integer", "minimum": 0, "maximum": 2 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "IK" } } },
          "then": { "required": ["target", "pole", "chain_count"] }
        }
      ]
    }
  }
}
